██╗██╗██╗███████╗██║░╚███║╚█████╔╝╚█████╔╝██║░░██║███████╗░░░██╗░░
╚═╝╚═╝╚═╝╚══════╝╚═╝░░╚══╝░╚════╝░░╚════╝░╚═╝░░╚═╝╚══════╝░░░╚═╝░░

  120 BPM in B MINOR :)
  
      Can't you say
       Can't you say
        Sometimes you say
         Can't you say
                          Sometimes, some days
                        Can't you say
                      Sometimes you say

*/

// GHOST KICK TR909
const encoreDrum = `bd [bd!2] [bd!4] bd <[bd!4] [bd!2]> bd <[bd!4] [bd!8]> [bd!3]`
const fourfourDrum = `bd!4`
_GHOSTKICKTECH: s(encoreDrum).bank("tr909")
  .slow(2)
  .diode("1:2.1")
  .duckorbit(2)

// HARDTECH HH FAST
_OOBMFASTHAT: s("hh -")
  .bank("tr808")
  .fast(16)
  .lpf(slider(9415, 3000, 11000, 1))
  .lpq(4);

// GHOST HARD SNARE
const encoreSnare = `- sd [- sd] - sd - [sd!2] [- sd] - sd [- sd] - [sd!4] [- sd] - [sd!4]`
const basicSnare = `- sd - sd - sd - sd`
_GHOSTSNARE: s(basicSnare).slow(2).bank("tr909").gain(1.55);

// basic ahhh clap 
_DRMZCLAPTHREE: s("- cp").fast(2).bank(drumz).gain(0.34).room(0.52).rsize(0.9)

// OH cuz
_GHOSTHATS: s("- oh")
  .fast(4)
  .bank("tr909")
  .hpf(1200)
  .gain(0.32)
  .pan(rand.range(0.2, 0.8))
  .room(0.6)

_GHOSTBUILDUP: s("sd").bank("tr909")
  .fast(16) // 8 -> 16 -> 32 !! ALWAYS START FROM 8
  .lpf(saw.slow(16).range(60,12000)).lpq(2)

_OOBMRISER: s("white")
  .seg(8)
  .lpf(saw.slow(32).range(60,12000)).lpq(2)
  .gain(0.4)
  .pg(slider(1,0,1,0.01))
  ._scope()

const ghostmel = "[6 _ 5] [5 4 _] <1 1 2 1> 0"
const ghostphrase = `
  [-3 0 - -] [0 - - 0] [- - 0 -] [-1 - -2 -]
  [-3 - - -] [-3 - - 2] [- - 2 -] [-1 - -1 -]
  [-3 0 - -] [0 - - 0] [- - 0 -] [-1 - 0 -]
  [-3 - - -] [0 - - -1] [- - 0 -] [1 - 2 -]
`

_GHOSTPHRASES: note(ghostphrase)
  .s("bytebeat")
  .scale(scalez)
  .slow(4)
  .trans(-12)
  .detune("0.2, 0.36")
  .fm(4).fmh(2)
  .gain(0.8)
  .acidenv(sine.slow(4).range(0.4,0.68))
  .delay(0.9).delayfb(0.6)
  .room(0.85).rsize(0.8)
  ._pianoroll()
  ._scope()
const ghostdrop = `
  [-3 0 _ -] [0 _ - 0] [- - 0 _] [-1 - -2 _]
  [-3 _ _ -] [-3 _ - 2] [2 - 2 _] [-1 _ -1 -]
  [-3 0 _ -] [0 _ - 0] [0 - 0 -] [-1 _ 0 -]
  [-3 _ _ -] [0 _ - -1] [-1 - 0 _] [1 _ 2 -]
`
_GHOSTDROP: note(ghostdrop)
  .s("supersaw")
  .scale(scalez)
  .slow(4)
  // .trancegate(1.25, 444, 1) // 444 good for drop
  .trans(12)
  .detune("-0.2, 1.2, 0.4")
  .decay(8)
  .diode("1.3:0.44")
  .room(0.8).rsize(1.3)
  .delay(0.9).delayfb(0.2)


_GHOSTSYNTH: note(ghostmel)
  .s("supersaw") 
  .scale(scalez)
  // .trancegate(1.25, 1441, 1) // GATE FOR DROP good ghost seed is 1441
  .trans(0) // trans 12 for BIG DROP
  .detune("0.2, 0.8, 1, 0.52")
  .decay(0.8)
  .room(0.87)
  .rsize(1.3)
  .delay(0.46)
  .pg(slider(0.5, 0, 1.5, 0.01))
  .o(3)
  ._pianoroll()
_ANGELVOICES: note((ghostmel))
  .s("supersaw") 
  .scale(scalez)
  .trans(0) // trans 12 for BIG DROP
  .detune("0.2, 0.8, 1, 0.52")
  .room(0.87)
  .rsize(1.3)
  .delay(0.46)
  .vowel("e [o u] a o")
  .pg(slider(0.55, 0, 0.8, 0.01))
  .o(3)
  ._pianoroll()

/* 

